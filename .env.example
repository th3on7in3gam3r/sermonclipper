# Vesper Studio — copy to .env.local and fill in values.
# Do NOT commit .env.local.

# ── Required: core app ──────────────────────────────────────────────
OPENAI_API_KEY=
CRON_SECRET=
MONGODB_URI=

# Clerk (use pk_test_/sk_test_ for localhost; pk_live_/sk_live_ for production domain)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_APP_URL=https://vesper.biblefunland.com

# Cloudflare R2 (uploads + media storage)
CF_ACCOUNT_ID=
R2_BUCKET=sermon-clipper
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
BUNNY_CDN_HOST=vesper.b-cdn.net
NEXT_PUBLIC_BUNNY_CDN_HOST=vesper.b-cdn.net
BUNNY_TOKEN_AUTHENTICATION_KEY=
MEDIA_SIGNING_SECRET=

# ── Required: production processing ─────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shotstack (reel export rendering)
SHOTSTACK_SANDBOX_KEY=
SHOTSTACK_PRODUCTION_KEY=
SHOTSTACK_ENV=production

# Email (transactional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Vesper Studio <hello@vesper.biblefunland.com>

# ── Optional ────────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PRICE_ID_CREATOR=
# NEXT_PUBLIC_STRIPE_PRICE_ID_CHURCH_PRO=
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# NEXT_PUBLIC_SENTRY_DSN=
# VIRUSTOTAL_API_KEY=
# YTDLP_COOKIES_PATH=./youtube_cookies.txt
# DEMO_VIDEO_BEFORE_KEY=demo/sermon-before.mp4
# DEMO_VIDEO_AFTER_KEY=demo/reel-after.mp4
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VESPER_ADMIN_IDS=

# Not used by Vesper core (remove from Vercel if present from another project):
# DATABASE_URL=
# NEXT_PUBLIC_TAWK_PROPERTY_ID=
# PLANNING_CENTER_CLIENT_ID=
# PLANNING_CENTER_CLIENT_SECRET=
